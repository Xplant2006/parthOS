alias userSP R0;
userSP=SP;
[PROCESS_TABLE +[SYSTEM_STATUS_TABLE + 1]*16 + 13] = SP;
[PROCESS_TABLE +[SYSTEM_STATUS_TABLE + 1]*16 + 9] = 9;

SP=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+11]*512-1;

alias physicalPageNum R1;
alias offset R2;
alias physicalAddr R3;
alias fileName R4;
physicalPageNum=[PAGE_TABLE_BASE + 20 * [SYSTEM_STATUS_TABLE + 1]+2*((userSP-4)/512)];
offset=(userSP-4)%512;
physicalAddr=offset+physicalPageNum*512;
fileName=[physicalAddr];

alias i R5;
alias flag R6;

i=0;
flag=0;

while(i<MAX_FILE_NUM)   do
    if([INODE_TABLE+i*16+1]==fileName)  then
        if([INODE_TABLE+i*16]==EXEC)    then
            flag=1;
            break;
        endif;
    endif;
    i=i+1;
endwhile;
if(flag==0) then
    physicalPageNum=[PAGE_TABLE_BASE + 20 * [SYSTEM_STATUS_TABLE + 1]+2*(userSP-1)/512];
    offset=(userSP-1)%512;
    physicalAddr=physicalPageNum*512+offset;
    [physicalAddr]=-1;
    [PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=0;
    SP=userSP;
    ireturn;
endif;

multipush(R0,R1,R2,R3,R4,R5,R6);
R1=3;
R2=[SYSTEM_STATUS_TABLE+1];
call MOD_1;
multipop(R0,R1,R2,R3,R4,R5,R6);

alias userpage R7;
userpage=[PROCESS_TABLE+16*[SYSTEM_STATUS_TABLE+1]+11];
[MEMORY_FREE_LIST+userpage]=[MEMORY_FREE_LIST+userpage]+1;
[SYSTEM_STATUS_TABLE+2]=[SYSTEM_STATUS_TABLE+2]-1;

SP=userpage*512;

[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+4]=RUNNING;
[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+7]=i;

[PTBR+0]=63;
[PTBR+1]="0100";
[PTBR+2]=64;
[PTBR+3]="0100";

multipush(R0,R1,R2,R3,R4,R5,R6,R7);

//Heap
[PTBR+4]=-1;
[PTBR+5]="0000";
[PTBR+6]=-1;
[PTBR+7]="0000";

//Stack
R1=1;
call MOD_2;
[PTBR+16]=R0;
[PTBR+17]="0110";
R1=1;
call MOD_2;
[PTBR+18]=R0;
[PTBR+19]="0110";

multipop(R0,R1,R2,R3,R4,R5,R6,R7);

alias numblocks R8;

numblocks=(([INODE_TABLE+i*16+2]-1)/512)+1;

alias j R9;

//Initializing First Code Block

multipush(R0,R1,R2,R3,R4,R5,R6,R7,R8,R9);
R1=5;
R2=[INODE_TABLE+i*16+8];
call MOD_2;
[PTBR+8]=R0;
[PTBR+9]="0100";
j=1;
while(j<4)  do
    [PTBR+8+j*2]=-1;
    [PTBR+9+j*2]="0000";
    j=j+1;
endwhile;
multipop(R0,R1,R2,R3,R4,R5,R6,R7,R8,R9);

//Initializing Disk Map Table
j=2;
while(j<9)  do
    if(j==2||j==3)  then
        [DISK_MAP_TABLE+[SYSTEM_STATUS_TABLE+1]*10+j]=-1;
    else
    if(j==9)    then
        [DISK_MAP_TABLE+[SYSTEM_STATUS_TABLE+1]*10+j]=-1;
    else
    if(j-4<numblocks)   then
        [DISK_MAP_TABLE+[SYSTEM_STATUS_TABLE+1]*10+j]=[INODE_TABLE+i*16+8+(j-4)];
    else
        [DISK_MAP_TABLE+[SYSTEM_STATUS_TABLE+1]*10+j]=-1;
    endif;
    endif;
    endif;
    j=j+1;
endwhile;
//Set Per-Process Resource Table entries to -1
j=1;
while(j<9)  do
    [([PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+11]+1)*512-2*j]=-1;
    j=j+1;
endwhile;

[[PTBR+16]*512]=[[PTBR+8]*512+1];

SP=8*512;
[PROCESS_TABLE +[SYSTEM_STATUS_TABLE + 1]*16 + 9] = 0;
ireturn;

