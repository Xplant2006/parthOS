
[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+9]=8;

[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+13]=SP;

SP=[PROCESS_TABLE+[SYSTEM_STATUS_TABLE+1]*16+11]*512-1;

R1=1;
call MOD_1;

alias childPID R0;
alias currPID R1;
alias page_table R2;
alias userSP R3;

currPID=[SYSTEM_STATUS_TABLE+1];
page_table=[PROCESS_TABLE+currPID*16+14];
userSP=[PROCESS_TABLE+currPID*16+13];

if(childPID==-1)    then
    [[page_table + 2*(userSP-1)/512] *512 + ((userSP-1)%512)] = -1;
    [PROCESS_TABLE + currPID*16 + 9] = 0;
    SP = userSP;
    ireturn;
endif;

//If heap pages arent allocated, allocate them for parent 

if([page_table+4]==-1)  then
    multipush(R0,R1,R2,R3);
    R1=1;
    call MOD_2;
    [page_table+4]=R0;
    [page_table+5]="0110";
    R1=1;
    call MOD_2;
    [page_table+6]=R0;
    [page_table+7]="0110";
    multipop(R0,R1,R2,R3);
endif;

alias parent_process_table R4;

parent_process_table=PROCESS_TABLE+currPID*16;

alias child_process_table R5;

child_process_table=PROCESS_TABLE+childPID*16;

//Process Table for child
[child_process_table+3]=[parent_process_table+3];
[child_process_table+6]=[parent_process_table+6];
[child_process_table+10]=[parent_process_table+10];
[child_process_table+7]=[parent_process_table+7];
[child_process_table+13]=[parent_process_table+13];
[child_process_table+9]=0;
[child_process_table+12]=0;
[child_process_table+0]=0;
[child_process_table+2]=currPID;
[child_process_table+4]=CREATED;

//Obtaining 3 free pages, 2 for user stack and 1 for user area page of child
multipush(R0,R1,R2,R3,R4,R5);
R1=1;
call MOD_2;
R6=R0;
multipush(R6);
R1=1;
call MOD_2;
R7=R0;
multipush(R7);
R1=1;
call MOD_2;
R8=R0;
multipop(R0,R1,R2,R3,R4,R5,R6,R7);

[child_process_table+11]=R6;

alias i R6;
i=0;
//Copying per-process resource table
while(i<8)  do
    [[child_process_table+11]*512+496+2*i]=[[parent_process_table+11]*512+496+2*i];
    [[child_process_table+11]*512+496+2*i+1]=[[parent_process_table+11]*512+496+2*i+1];
    if([[child_process_table+11]*512+496+2*i]==1)   then
        [SEMAPHORE_TABLE+[[child_process_table]*512+496+2*i+1]*4+1]=[SEMAPHORE_TABLE+[[child_process_table]*512+496+2*i+1]*4+1]+1;
    endif;
    i=i+1;
endwhile;
//Copying per-process disk map table
i=2;
while(i<10) do
    [DISK_MAP_TABLE+childPID*10+i]=[DISK_MAP_TABLE+currPID*10+i];
    i=i+1;
endwhile;

alias child_page_table R9;
child_page_table=[child_process_table+14];
//Setting page tables
i=0;
while(i<16) do
    [child_page_table+i]=[page_table+i];
    if(i%2==0)  then
        if([page_table+i]!=-1)  then
            [MEMORY_FREE_LIST+[page_table+i]]=[MEMORY_FREE_LIST+[page_table+i]]+1;
        endif;
    endif;
    i=i+1;
endwhile;

[child_page_table+16]=R7;
[child_page_table+17]=[page_table+17];
[child_page_table+18]=R8;
[child_page_table+19]=[page_table+19];
//Copying word by word the contents of the parent user stack to that of the child
i=0;
while(i<512)    do
    [[child_page_table+16]*512+i]=[[page_table+16]*512+i];
    [[child_page_table+18]*512+i]=[[page_table+18]*512+i];
    i=i+1;
endwhile;

[[child_process_table+11]*512]=BP;

[([page_table + 2*(userSP-1)/512])*512 + ((userSP-1)%512)] = childPID;
[([child_page_table + 2*(userSP-1)/512])*512 + ((userSP-1)%512)] = 0;

[parent_process_table+9]=0;

SP=userSP;
ireturn;

