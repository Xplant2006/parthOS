//Load Program
loadi(83,69);


[TERMINAL_STATUS_TABLE]=0;

PTBR=PAGE_TABLE_BASE+20;
PTLR=10;

// Lib
[PTBR+0]=63;
[PTBR+1]="0100";
[PTBR+2]=64;
[PTBR+3]="0100";
// Heap
[PTBR+4]=78;
[PTBR+5]="0110";
[PTBR+6]=79;
[PTBR+7]="0110";
// Code
[PTBR+8]=65;
[PTBR+9]="0100";
[PTBR+10]=66;
[PTBR+11]="0100";
[PTBR+12]=-1;
[PTBR+13]="0000";
[PTBR+14]=-1;
[PTBR+15]="0000";
// Stack
[PTBR+16]=76;
[PTBR+17]="0110";
[PTBR+18]=77;
[PTBR+19]="0110";

[PROCESS_TABLE+27] = 80;
[PROCESS_TABLE+28] = 0;
[PROCESS_TABLE+29]=8*512;
[PROCESS_TABLE+30]=PAGE_TABLE_BASE+20;
[PROCESS_TABLE+31]=10;
[PROCESS_TABLE+17] = 1;
[PROCESS_TABLE+20]=CREATED;

[76*512]=[65*512+1];

// MARKING ALL OTHER PROCESS TABLE ENTRIES AS TERMINATED
alias i R6;
i=2;
while(i<16) do
    [PROCESS_TABLE + 16*i + 4] = TERMINATED;
    i=i+1;
endwhile;

i=0;
while(i<=82)do
	[MEMORY_FREE_LIST+i]=1;
	i=i+1;
endwhile;
while(i<=127)do
	[MEMORY_FREE_LIST+i]=0;
	i=i+1;
endwhile;

[TERMINAL_STATUS_TABLE + 0] = 0;
[SYSTEM_STATUS_TABLE + 2] = 45;
[SYSTEM_STATUS_TABLE + 3] = 0;

[DISK_STATUS_TABLE+0]=0;

i = 1;
while (i < 9) do
    [([PROCESS_TABLE + 0* 16 + 11] + 1) * 512 - 2 * i] = -1;
    i = i + 1;
endwhile;

return;
