alias currPID R1;
alias userSP R2;
alias systemcall R3;
alias process_table_entry R4;

currPID=[SYSTEM_STATUS_TABLE+1];
userSP=SP;
process_table_entry=PROCESS_TABLE+16*currPID;

[process_table_entry+13]=SP;
SP=[process_table_entry+11]*512-1;

systemcall=[[PTBR+2*(userSP-5)/512]*512+(userSP-5)%512];



//Wait
if(systemcall==13)  then
    [process_table_entry+9]=systemcall;
    alias PID R5;
	PID = [[PTBR + 2*(userSP-4)/512]*512 + (userSP-4)%512];
    if(PID==currPID||[PROCESS_TABLE+PID*16+4]==TERMINATED||PID<1||PID>15)    then
        [[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512]=-1;
        [process_table_entry+9]=0;
        SP=userSP;
        ireturn;
    endif;
    [process_table_entry+4]=WAIT_PROCESS;
    [process_table_entry+5]=PID;
    multipush(R0,R1,R2,R3,R4,R5);
    call MOD_5;
    multipop(R0,R1,R2,R3,R4,R5);
    [process_table_entry+9]=0;
    [[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512]=0;
    SP=userSP;
    ireturn;
endif;

//Signal

if(systemcall==14)  then
    [process_table_entry+9]=systemcall;
    alias i R5;
    i=1;
    while(i<16) do
        if([PROCESS_TABLE+i*16+4]==WAIT_PROCESS&&[PROCESS_TABLE+i*16+5]==currPID)   then
            [PROCESS_TABLE+i*16+4]=READY;
            [PROCESS_TABLE+i*16+5]=-1;
        endif;
        i=i+1;
    endwhile;
    [process_table_entry+9]=0;
    [[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512]=0;
    SP=userSP;
    ireturn;
endif;

//GetPID
if(systemcall==11)  then
    [process_table_entry+9]=systemcall;
    [[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512]=currPID;
    [process_table_entry+9]=0;
    SP=userSP;
    ireturn;
endif;

//GetPPID
if(systemcall==12)  then
    [process_table_entry+9]=systemcall;
    [[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512]=[process_table_entry+2];
    [process_table_entry+9]=0;
    SP=userSP;
    ireturn;
endif;