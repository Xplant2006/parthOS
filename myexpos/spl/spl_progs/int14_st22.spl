alias userSP R1;
userSP=SP;

alias currPID R2;
currPID=[SYSTEM_STATUS_TABLE+1];

alias process_entry R3;
process_entry=PROCESS_TABLE+currPID*16;

alias syscall R4;
syscall=[[PTBR+2*(userSP-5)/512]*512+(userSP-5)%512];

[process_entry+13]=userSP;
SP=[process_entry+11]*512-1;
[process_entry+9]=syscall;

//SemLock System Call
if(syscall==19) then
    alias semid R5;
    semid=[[PTBR+(userSP-4)/512]*512+(userSP-4)%512];

    alias resource_table R6;

    resource_table=([process_entry+11])*512+RESOURCE_TABLE_OFFSET;

    if(semid<0||semid>7||[resource_table+2*semid]!=1)   then
        SP=[process_entry+13];
        [process_entry+9]=0;
        [[PTBR+2*(userSP-1)/512]*512+(userSP-1)%512]=-1;
        ireturn;
    endif;

    alias semind R7;

    semind=[resource_table+semid*2+1];

    while([SEMAPHORE_TABLE+4*semind]!=-1 && [SEMAPHORE_TABLE+4*semind]!=currPID)  do
        [process_entry+4]=WAIT_SEMAPHORE;
        [process_entry+5]=semind;
        multipush(R1,R2,R3,R4,R5,R6,R7);
        call MOD_5;
        multipop(R1,R2,R3,R4,R5,R6,R7);
    endwhile;

    [SEMAPHORE_TABLE+semind*4]=currPID;
    [[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512] = 0;
    SP=[process_entry+13];
    [process_entry+9]=0;
    ireturn;
endif;

//SemUnlock System Call

if(syscall==20) then
    alias semid R5;
    semid=[[PTBR+(userSP-4)/512]*512+(userSP-4)%512];

    alias resource_table R6;

    resource_table=([process_entry+11])*512+RESOURCE_TABLE_OFFSET;

    if(semid<0||semid>7||[resource_table+2*semid]!=1)   then
        SP=[process_entry+13];
        [process_entry+9]=0;
        [[PTBR+2*(userSP-1)/512]*512+(userSP-1)%512]=-1;
        ireturn;
    endif;

    alias semind R7;

    semind=[resource_table+2*semid+1];

    if([SEMAPHORE_TABLE+4*semind]!=-1)  then
        if([SEMAPHORE_TABLE+4*semind]!=currPID) then
            SP=[process_entry+13];
            [process_entry+9]=0;
            [[PTBR+2*(userSP-1)/512]*512+(userSP-1)%512]=-2;
            ireturn;
        endif;
        [SEMAPHORE_TABLE+4*semind]=-1;
        alias i R8;
        i=1;
        while(i<16) do
            if([PROCESS_TABLE+4+i*16]==WAIT_SEMAPHORE&&[PROCESS_TABLE+5+i*16]==semind)  then
                [PROCESS_TABLE+4+i*16]=READY;
                [PROCESS_TABLE+i*16+5]=-1;
            endif;
            i=i+1;
        endwhile;
    endif;
    [[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512] = 0;
    SP=[process_entry+13];
    [process_entry+9]=0;
    ireturn;
endif;