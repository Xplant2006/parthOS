// Create and Delete System Calls

alias userSP R1;
userSP=SP;

alias currPID R2;
currPID=[SYSTEM_STATUS_TABLE+1];

alias process_entry R3;
process_entry=PROCESS_TABLE+currPID*16;

[process_entry+13]=SP;
SP=[process_entry+11]*512-1;

alias syscall R4;
syscall=[[PTBR+2*(userSP-5)/512]*512+(userSP-5)%512];

[process_entry+9]=syscall;

//Create System Call

if(syscall==1)  then
    alias filename R5;
    alias permission R6;
    filename=[[PTBR+2*(userSP-4)/512]*512+(userSP-4)%512];
    permission=[[PTBR+2*(userSP-3)/512]*512+(userSP-3)%512];

    alias i R7;
    i=1;
    while(i<MAX_FILE_NUM)   do
        if([INODE_TABLE+i*16+1]==filename)  then
            R11=0;
            goto retLabel;
        endif;
        i=i+1;
    endwhile;
    i=1;
    while(i<MAX_FILE_NUM)   do
        if([INODE_TABLE+i*16+1]==-1)    then
            break;
        endif;
        i=i+1;
    endwhile;
    if(i==MAX_FILE_NUM) then
        R11=-1;
        goto retLabel;
    endif;
    [INODE_TABLE+i*16+0]=DATA;
    [INODE_TABLE+i*16+1]=filename;
    [INODE_TABLE+i*16+2]=0;
    [INODE_TABLE+i*16+8]=-1;
    [INODE_TABLE+i*16+9]=-1;
    [INODE_TABLE+i*16+10]=-1;
    [INODE_TABLE+i*16+11]=-1;
    [INODE_TABLE+i*16+3]=[process_entry+3];
    [INODE_TABLE+i*16+4]=permission;
    [ROOT_FILE+i*8+0]=filename;
    [ROOT_FILE+i*8+1]=0;
    [ROOT_FILE+i*8+2]=DATA;
    [ROOT_FILE+i*8+3] = [USER_TABLE+2*[process_entry+3]];
    [ROOT_FILE+i*8+4]=permission;
    R11=0;
    goto retLabel;
endif;

//Delete System Call

if(syscall==4)  then
    alias filename R5;
    filename=[[PTBR+2*(userSP-4)/512]*512+(userSP-4)%512];

    alias i R6;
    i=1;
    while(i<MAX_FILE_NUM)   do
        if([INODE_TABLE+i*16+1]==filename)  then
            break;
        endif;
        i=i+1;
    endwhile;
    if(i==MAX_FILE_NUM) then
        R11=0;
        goto retLabel;
    endif;
    if([INODE_TABLE+i*16+0]!=DATA)  then
        R11=-1;
        goto retLabel;
    endif;

    if([INODE_TABLE+i*16+4]==EXCLUSIVE) then
        if([INODE_TABLE+i*16+3]!=[SYSTEM_STATUS_TABLE+0] && [SYSTEM_STATUS_TABLE+0]!=1) then
            R11=-1;
            goto retLabel;
        endif;
    endif;

    multipush(R1,R2,R3,R4,R5,R6);
    R1=4;
    R3=currPID;
    R2=1;
    call MOD_0;
    multipop(R1,R2,R3,R4,R5,R6);

    if([FILE_STATUS_TABLE+i*4+1]!=-1)   then
        multipush(R1,R2,R3,R4,R5,R6);
        R1=5;
        R3=currPID;
        R2=i;
        call MOD_0;
        multipop(R1,R2,R3,R4,R5,R6);
        R11=-2;
        goto retLabel;
    endif;

    alias inodeEntry R7;
    inodeEntry = INODE_TABLE+i*16;
    alias inodeIndex R10;
    inodeIndex=i;
    i=8;
    while(i<12) do
        alias blockNum R8;
        blockNum=[inodeEntry+i];
        alias buffEntry R9;
        buffEntry=BUFFER_TABLE+(blockNum%MAX_BUFFER)*4;
        if([inodeEntry+i]!=-1)  then
            if([buffEntry]==blockNum && [buffEntry+1]==1)   then
                [buffEntry+1]=0;
            endif;
            multipush(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10);
            R1=4;
            R3=currPID;
            R2=blockNum;
            call MOD_2;
            multipop(R1,R2,R3,R4,R5,R6,R7,R8,R9,R10);
        endif;
        i=i+1;
    endwhile;
    i=0;
    while(i<16) do
        if(i<5) then
            [ROOT_FILE+inodeIndex*8+i]=-1;
        endif;
        [inodeEntry+i]=-1;
        i=i+1;
    endwhile;


    multipush(R1,R3);
    R1=5;
    R2=currPID;
    call MOD_0;
    multipop(R1,R3);
    R11=0;
    goto retLabel;
endif;

retLabel:
    SP=userSP;
    [process_entry+9]=0;
    [[PTBR + 2*(userSP-1)/512]*512 + (userSP-1)%512] = R11;
    ireturn;