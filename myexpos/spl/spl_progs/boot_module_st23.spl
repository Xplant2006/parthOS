//INODE TABLE
loadi(59,3);
loadi(60,4);
//Disk Free List
loadi(61,2);
//INT 9
loadi(20,33);
loadi(21,34);
//MODULE 1 (PROCESS MANAGER)
loadi(42,55);
loadi(43,56);
//MODULE 2 (MEMORY MANAGER)
loadi(44,57);
loadi(45,58);
//INT 7
loadi(16,29);
loadi(17,30);
//Timer Interrupt
loadi(4,17);
loadi(5,18);
//Library
loadi(63,13);
loadi(64,14);
//INIT Program
loadi(65,7);
loadi(66,8);
//INT 10
loadi(22,35);
loadi(23,36);
//Exception Handler
loadi(2,15);
loadi(3,16);
//Scheduler Module
loadi(50,63);
loadi(51,64);
//Resource Manager Module
loadi(40,53);
loadi(41,54);
//Device Manager Module
loadi(48,61);
loadi(49,62);
//INT 6 
loadi(14,27);
loadi(15,28);
//Console Interrupt
loadi(8,21);
loadi(9,22);
//Disk Interrupt
loadi(6,19);
loadi(7,20);
//Fork Interrupt
loadi(18,31);
loadi(19,32);
//INT 11
loadi(24, 37);
loadi(25, 38);
//INT 14
loadi(30, 43);
loadi(31, 44);
//INT 13
loadi(28, 41); 
loadi(29, 42);
//INT 15
loadi(32, 45);
loadi(33, 46);
//INT 4
loadi(10,23);
loadi(11,24);
//Root file
loadi(62,5);


[TERMINAL_STATUS_TABLE]=0;

PTBR=PAGE_TABLE_BASE+20;
PTLR=10;

// Lib
[PTBR+0]=63;
[PTBR+1]="0100";
[PTBR+2]=64;
[PTBR+3]="0100";
// Heap
[PTBR+4]=78;
[PTBR+5]="0110";
[PTBR+6]=79;
[PTBR+7]="0110";
// Code
[PTBR+8]=65;
[PTBR+9]="0100";
[PTBR+10]=66;
[PTBR+11]="0100";
[PTBR+12]=-1;
[PTBR+13]="0000";
[PTBR+14]=-1;
[PTBR+15]="0000";
// Stack
[PTBR+16]=76;
[PTBR+17]="0110";
[PTBR+18]=77;
[PTBR+19]="0110";

[PROCESS_TABLE+27] = 80;
[PROCESS_TABLE+28] = 0;
[PROCESS_TABLE+29]=8*512;
[PROCESS_TABLE+30]=PAGE_TABLE_BASE+20;
[PROCESS_TABLE+31]=10;
[PROCESS_TABLE+17] = 1;
[PROCESS_TABLE+20]=CREATED;

[76*512]=[65*512+1];

// MARKING ALL OTHER PROCESS TABLE ENTRIES AS TERMINATED
alias i R6;
i=2;
while(i<16) do
    [PROCESS_TABLE + 16*i + 4] = TERMINATED;
    i=i+1;
endwhile;

//Initializing Memory Free List
i=0;
while(i<=82)do
	[MEMORY_FREE_LIST+i]=1;
	i=i+1;
endwhile;
while(i<=127)do
	[MEMORY_FREE_LIST+i]=0;
	i=i+1;
endwhile;

[TERMINAL_STATUS_TABLE + 0] = 0;
[SYSTEM_STATUS_TABLE + 2] = 45;
[SYSTEM_STATUS_TABLE + 3] = 0;

[DISK_STATUS_TABLE+0]=0;

//Initializing Per-Process Resource Table of Init
i = 1;
while (i < 9) do
    [([PROCESS_TABLE + 16 + 11] + 1) * 512 - 2 * i] = -1;
    i = i + 1;
endwhile;

//Initializing Disk Map Table for Init
[DISK_MAP_TABLE + 10*1 + 2] = -1;
[DISK_MAP_TABLE + 10*1 + 3] = -1;
[DISK_MAP_TABLE + 10*1 + 4] = 7;
[DISK_MAP_TABLE + 10*1 + 5] = 8;
[DISK_MAP_TABLE + 10*1 + 6] = -1;
[DISK_MAP_TABLE + 10*1 + 7] = -1;
[DISK_MAP_TABLE + 10*1 + 8] = -1;
[DISK_MAP_TABLE + 10*1 + 9] = -1;

//Initialize Semaphore Table
i=0;
while(i<32) do
    [SEMAPHORE_TABLE+i*4]=-1;
    [SEMAPHORE_TABLE+i*4+1]=0;
    i=i+1;
endwhile;

//Initialize File Status Table
i=0;
while(i<MAX_FILE_NUM)   do
    [FILE_STATUS_TABLE+4*i]=-1;
    [FILE_STATUS_TABLE+4*i+1]=-1;
    i=i+1;
endwhile;

//Initialize Buffer Table
i=0;
while(i<MAX_BUFFER) do
    [BUFFER_TABLE+4*i]=-1;
    [BUFFER_TABLE+4*i+1]=0;
    [BUFFER_TABLE+4*i+2]=-1;
    i=i+1;
endwhile;

//Set userID for INIT
[PROCESS_TABLE+16+3]=1;
return;
