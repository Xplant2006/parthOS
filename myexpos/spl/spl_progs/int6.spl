alias currentPID R1;
currentPID=[SYSTEM_STATUS_TABLE+1];

// Setting MODE FLAG
[PROCESS_TABLE+currentPID*16+9]=7;

alias userSP R0;
userSP=SP;

// Storing SP in UPTR and changing to kernel stack
[PROCESS_TABLE+currentPID*16+13]=userSP;
SP=[PROCESS_TABLE+currentPID*16+11]*512-1;

alias process_table R2;
process_table=PROCESS_TABLE+currentPID*16;
alias page_table R3;
page_table=PAGE_TABLE_BASE+20*currentPID;
alias fileDescriptor R4;

fileDescriptor=[[page_table + 2*(userSP-4)/512]*512 + (userSP-4)%512];

if(fileDescriptor!=-1)  then
    [[page_table + 2*(userSP-1)/512]*512 + (userSP-1)%512] = 	-1;

else
    alias wordaddr R5;
    wordaddr=[[page_table + 2*(userSP-3)/512]*512 + (userSP-3)%512];
    multipush(R0,R1,R2,R3,R4,R5);
    R1=4;
    R2=[SYSTEM_STATUS_TABLE+1];
    R3=R5;
    call MOD_4;
    multipop(R0,R1,R2,R3,R4,R5);
    [[page_table + 2*(userSP-1)/512]*512 + (userSP-1)%512] =  0;

endif;

[PROCESS_TABLE+currentPID*16+9]=0;
SP=userSP;
ireturn;

